<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="703.0" prefWidth="1279.0" styleClass="intro-root" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.IntroController">
   <children>
      <!-- Centered Content -->
      <VBox alignment="CENTER" prefWidth="1279.0" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" lineSpacing="1.0" prefHeight="250.0" prefWidth="1100.0" stylesheets="@styles.css" text="War-Time Information Passing System" textAlignment="CENTER" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="System Bold" size="64.0" />
               </font>
               <effect>
                  <DropShadow blurType="GAUSSIAN" color="BLACK" height="10.0" radius="10.0" spread="0.5" width="10.0" />
               </effect>
               <style>-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 12, 0.4, 0, 0);</style>
            </Label>
            <Button fx:id="btnNext" mnemonicParsing="false" prefHeight="55.0" prefWidth="380.0" style="-fx-font-size: 24px; -fx-padding: 10 30 10 30; -fx-cursor: hand; -fx-font-weight: bold;" text="Start Operations" textAlignment="CENTER" />
         </children>
      </VBox>

      <!-- Info Button Top Right -->
      <Button fx:id="btnInfo" mnemonicParsing="false" style="-fx-cursor: hand; -fx-font-size: 18px; -fx-min-width: 40; -fx-min-height: 40; -fx-background-radius: 20;" text="i" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0" />
   </children>
</AnchorPane>
