<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox styleClass="standard-root" alignment="CENTER" spacing="40.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.OptionController">
   <children>
      <Label text="OPERATIONAL COMMAND">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
         <style>-fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 10, 0.5, 0, 0);</style>
      </Label>
      
      <VBox alignment="CENTER" spacing="25.0">
          <Button fx:id="btnSend" mnemonicParsing="false" prefHeight="65.0" prefWidth="350.0" text="SEND ENCRYPTED MESSAGE" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;" />
          <Button fx:id="btnDecrypt" mnemonicParsing="false" prefHeight="65.0" prefWidth="350.0" text="DECRYPT INBOX" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;" />
          <Button fx:id="btnCreateGroup" mnemonicParsing="false" prefHeight="65.0" prefWidth="350.0" text="GROUP MANAGEMENT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand;" visible="false" />
          <Button fx:id="btnLogout" mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0" text="LOGOUT" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #7f8c8d; -fx-cursor: hand;" />
      </VBox>
   </children>
</VBox>
