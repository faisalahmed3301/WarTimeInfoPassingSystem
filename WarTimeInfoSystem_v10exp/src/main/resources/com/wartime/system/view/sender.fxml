<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" styleClass="standard-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.SenderController">
   <children>
      <Label text="TRANSMISSION INTERFACE">
         <font>
             <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <!-- Message Content Area -->
      <VBox fx:id="messageContentBox" alignment="CENTER_LEFT" maxWidth="650.0" prefHeight="204.0" prefWidth="650.0" spacing="8.0">
          <!-- Priority + Mode Toggle Row -->
          <HBox alignment="CENTER_LEFT" spacing="10.0">
              <Label style="-fx-font-weight: bold;" text="Message Content:" />
              <HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-padding: 0 0 0 20;">
                  <ToggleButton fx:id="tglNormal" prefHeight="28.0" style="-fx-font-size: 11px; -fx-background-color: #2A3020; -fx-text-fill: #00ff00; -fx-border-color: #00aa00; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12;" text="● NORMAL" />
                  <ToggleButton fx:id="tglWarning" prefHeight="28.0" style="-fx-font-size: 11px; -fx-background-color: #2A3020; -fx-text-fill: #ffcc00; -fx-border-color: #aa8800; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12;" text="● WARNING" />
                  <ToggleButton fx:id="tglCritical" prefHeight="28.0" style="-fx-font-size: 11px; -fx-background-color: #2A3020; -fx-text-fill: #ff4444; -fx-border-color: #aa0000; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12;" text="● CRITICAL" />
              </HBox>
              <ToggleButton fx:id="tglMissionBrief" prefHeight="28.0" style="-fx-font-size: 11px; -fx-background-color: #414833; -fx-text-fill: #E8E8E8; -fx-border-color: #582F0E; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12;" text="📋 Mission Brief" />
          </HBox>
          <!-- Normal TextArea (default visible) -->
          <TextArea fx:id="txtMessage" prefHeight="155.0" prefWidth="610.0" promptText="Enter confidential directive..." styleClass="terminal-input" wrapText="true" />
          <!-- Mission Brief Fields (hidden by default) -->
          <VBox fx:id="missionBriefBox" managed="false" spacing="8.0" style="-fx-background-color: #1A1F14; -fx-border-color: #582F0E; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15;" visible="false">
              <Label style="-fx-text-fill: #A4AC86; -fx-font-weight: bold; -fx-font-size: 13px;" text="══════ MISSION BRIEF ══════" />
              <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <Label prefWidth="80.0" style="-fx-text-fill: #E8E8E8; -fx-font-weight: bold;" text="Mission:" />
                  <TextField fx:id="txtMission" prefWidth="400.0" promptText="e.g. Reconnaissance" />
              </HBox>
              <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <Label prefWidth="80.0" style="-fx-text-fill: #E8E8E8; -fx-font-weight: bold;" text="Location:" />
                  <TextField fx:id="txtLocation" prefWidth="400.0" promptText="e.g. Sector B" />
              </HBox>
              <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <Label prefWidth="80.0" style="-fx-text-fill: #E8E8E8; -fx-font-weight: bold;" text="Time:" />
                  <TextField fx:id="txtTime" prefWidth="400.0" promptText="e.g. 2200 hrs" />
              </HBox>
              <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <Label prefWidth="80.0" style="-fx-text-fill: #E8E8E8; -fx-font-weight: bold;" text="Commander:" />
                  <ComboBox fx:id="cmbMissionCommander" prefWidth="400.0" promptText="Select Commander" />
              </HBox>
          </VBox>
      </VBox>
      
       <HBox alignment="CENTER" spacing="30.0">
           <VBox spacing="5.0">
               <Label text="Encryption Method:" />
               <ComboBox fx:id="cmbEncryption" prefWidth="180.0" />
           </VBox>
           
           <VBox spacing="5.0">
               <Label text="Authorizing Appointment:" />
               <ComboBox fx:id="cmbAppointment" prefWidth="180.0" />
           </VBox>

           <VBox spacing="5.0">
               <Label text="Target Group:" />
               <ComboBox fx:id="cmbGroup" prefWidth="180.0" />
           </VBox>

           <VBox spacing="5.0">
               <Label text="Individual Recipient:" />
               <ComboBox fx:id="cmbRecipient" prefWidth="180.0" />
           </VBox>
       </HBox>
      
      <VBox alignment="CENTER" maxWidth="250.0" spacing="5.0">
          <Label text="Encryption Key:" />
          <TextField fx:id="txtKey" alignment="CENTER" />
      </VBox>

      <Button fx:id="btnEmergency" managed="false" mnemonicParsing="false" prefHeight="50.0" prefWidth="350.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #8B0000; -fx-text-fill: #FFFFFF; -fx-border-color: #FF0000; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;" text="⚠ SEND EMERGENCY ALERT ⚠" visible="false" />
      
      <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0 0 0;">
          <Button fx:id="btnSend" mnemonicParsing="false" prefWidth="150.0" style="-fx-font-size: 14px;" text="TRANSMIT" />
          <Button fx:id="btnReturn" mnemonicParsing="false" prefWidth="150.0" text="RETURN" />
      </HBox>
   </children>
</VBox>
