<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="standard-root" alignment="CENTER" spacing="40.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.OptionController">
   <children>
      <Label text="OPERATIONAL COMMAND">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Label>
      
      <VBox alignment="CENTER" spacing="20.0">
          <Button fx:id="btnSend" mnemonicParsing="false" prefHeight="60.0" prefWidth="300.0" text="SEND ENCRYPTED MESSAGE" style="-fx-font-size: 16px;" />
          <Button fx:id="btnDecrypt" mnemonicParsing="false" prefHeight="60.0" prefWidth="300.0" text="DECRYPT INBOX" style="-fx-font-size: 16px;" />
      </VBox>
   </children>
</VBox>
