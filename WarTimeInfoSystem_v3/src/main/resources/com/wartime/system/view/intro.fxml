<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="848.0" prefWidth="1007.0" styleClass="intro-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.IntroController">
   <children>
      <!-- Centered Content -->
      <VBox alignment="CENTER" prefWidth="643.0" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" lineSpacing="1.0" prefHeight="125.0" prefWidth="953.0" stylesheets="@styles.css" text="War-Time Information Passing System" textAlignment="CENTER" textFill="WHITE" wrapText="true">
               <font>
                  <Font name="Baloo 2 ExtraBold" size="50.0" />
               </font>
               <effect>
                  <DropShadow spread="0.6">
                     <color>
                        <Color opacity="0.7342256307601929" />
                     </color></DropShadow>
               </effect>
            </Label>
            <Button fx:id="btnNext" mnemonicParsing="false" prefHeight="46.0" prefWidth="322.0" style="-fx-font-size: 20px; -fx-padding: 10 30 10 30;" text="Start Operations" textAlignment="CENTER">
               <font>
                  <Font name="Baloo 2 Regular" size="13.0" />
               </font></Button>
         </children>
      </VBox>

      <!-- Info Button Top Right -->
      <Button fx:id="btnInfo" mnemonicParsing="false" text="i" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <font>
            <Font name="Beirut Regular" size="16.0" />
         </font></Button>
   </children>
</AnchorPane>
