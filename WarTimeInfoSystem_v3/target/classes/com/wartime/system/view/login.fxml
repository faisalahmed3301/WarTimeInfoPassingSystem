<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="408.0" prefWidth="396.0" spacing="20.0" styleClass="standard-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.LoginController">
   <children>
      <Label text=" LOGIN">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Label>
      
      <VBox alignment="CENTER" maxWidth="400.0" spacing="15.0">
         <children>
             <Label style="-fx-font-size: 14px;" text="Name" />
             <TextField fx:id="txtName" promptText="Enter Name" />
             
             <Label style="-fx-font-size: 14px;" text="Appointment" />
             <ComboBox fx:id="cmbAppointment" maxWidth="Infinity" promptText="Select Rank" />
             
             <Label style="-fx-font-size: 14px;" text="Password" />
             <PasswordField fx:id="txtPassword" promptText="Enter Password" />
         </children>
      </VBox>
      
      <Button fx:id="btnLogin" mnemonicParsing="false" style="-fx-font-size: 16px; -fx-padding: 10 40;" text="AUTHENTICATE" />
   </children>
</VBox>
