<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="standard-root" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.ReceiverController">
   <children>
      <Label text="INCOMING TRANSMISSIONS">
         <font>
             <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <Label fx:id="lblStatus" text="Status: Listening..." textFill="#aaaaaa" />

       <HBox alignment="CENTER" spacing="10.0">
           <ToggleButton fx:id="tglPrivate" text="INDIVIDUAL CHATS" prefWidth="200.0" selected="true"/>
           <ToggleButton fx:id="tglGroup" text="GROUP CHATS" prefWidth="200.0"/>
       </HBox>
      
      <ListView fx:id="lstMessages" maxHeight="400.0" maxWidth="700.0" VBox.vgrow="ALWAYS" />
      
      <Label text="* Double-click a transmission to attempt decryption" textFill="#888888" />
      
      <HBox alignment="CENTER" spacing="20.0">
          <Button fx:id="btnReturn" mnemonicParsing="false" prefWidth="150.0" text="RETURN" />
          <Button fx:id="btnExit" mnemonicParsing="false" prefWidth="150.0" text="EXIT SYSTEM" />
      </HBox>
   </children>
</VBox>
