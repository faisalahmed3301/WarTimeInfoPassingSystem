<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox styleClass="standard-root" alignment="CENTER" spacing="40.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.OptionController">
   <children>
      <Label text="OPERATIONAL COMMAND" styleClass="label">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      
      <VBox alignment="CENTER" spacing="25.0">
          <Button fx:id="btnSend" mnemonicParsing="false" styleClass="button primary" prefHeight="65.0" prefWidth="350.0" text="SEND ENCRYPTED MESSAGE" />
          <Button fx:id="btnDecrypt" mnemonicParsing="false" styleClass="button" prefHeight="65.0" prefWidth="350.0" text="DECRYPT INBOX" />
          <Button fx:id="btnCreateGroup" mnemonicParsing="false" styleClass="button" prefHeight="65.0" prefWidth="350.0" text="GROUP MANAGEMENT" visible="false" />
          <Button fx:id="btnLogout" mnemonicParsing="false" styleClass="button secondary" prefHeight="40.0" prefWidth="150.0" text="LOGOUT" />
      </VBox>
   </children>
</VBox>
