<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="standard-root" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.SenderController">
   <children>
      <Label text="TRANSMISSION INTERFACE" styleClass="label">
          <font>
              <Font name="System Bold" size="24.0" />
          </font>
      </Label>
       
      <VBox maxWidth="600.0" spacing="10.0" alignment="CENTER_LEFT">
          <Label text="Message Content:" styleClass="label" style="-fx-font-weight: bold;"/>
          <TextArea fx:id="txtMessage" styleClass="terminal-input" prefHeight="150.0" wrapText="true" promptText="Enter confidential directive..." />
      </VBox>
      
       <HBox alignment="CENTER" spacing="30.0">
           <VBox spacing="5.0">
               <Label text="Encryption Method:" styleClass="label"/>
               <ComboBox fx:id="cmbEncryption" prefWidth="180.0" />
           </VBox>
           
           <VBox spacing="5.0">
               <Label text="Authorizing Appointment:" styleClass="label"/>
               <ComboBox fx:id="cmbAppointment" prefWidth="180.0" />
           </VBox>

           <VBox spacing="5.0">
               <Label text="Target Group:" styleClass="label"/>
               <ComboBox fx:id="cmbGroup" prefWidth="180.0" />
           </VBox>

           <VBox spacing="5.0">
               <Label text="Individual Recipient:" styleClass="label"/>
               <ComboBox fx:id="cmbRecipient" prefWidth="180.0" />
           </VBox>
       </HBox>
      
      <VBox maxWidth="250.0" spacing="5.0" alignment="CENTER">
          <Label text="Encryption Key:" styleClass="label"/>
          <TextField fx:id="txtKey" alignment="CENTER" />
      </VBox>

      <Button fx:id="btnEmergency" mnemonicParsing="false" styleClass="button btn-danger" prefHeight="50.0" prefWidth="350.0" text="⚠ EMERGENCY ALERT ⚠" visible="false" managed="false" />
      <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0 0 0;">
          <Button fx:id="btnSend" mnemonicParsing="false" styleClass="button primary" prefWidth="150.0" text="TRANSMIT" />
          <Button fx:id="btnReturn" mnemonicParsing="false" styleClass="button secondary" prefWidth="150.0" text="RETURN" />
      </HBox>
   </children>
</VBox>
