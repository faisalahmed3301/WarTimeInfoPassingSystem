<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.GaussianBlur?>

<BorderPane stylesheets="@styles.css" styleClass="root" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.ReceiverController">

    <!-- LEFT: 60px Global Navigation Rail -->
    <left>
        <VBox prefWidth="76.0" styleClass="nav-rail-global" alignment="TOP_CENTER" spacing="24.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24.0" bottom="24.0" left="12.0" right="12.0"/>
            </padding>
            <Circle radius="18.0" fill="#201F1F" stroke="#50C878" strokeWidth="2.0"/>
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="btnReturn" text="↩" style="-fx-font-size: 18px;" styleClass="secondary-button" prefWidth="48.0" prefHeight="48.0" tooltip="Return"/>
            <Button fx:id="btnExit" text="⏻" style="-fx-font-size: 18px;" styleClass="danger-button" prefWidth="48.0" prefHeight="48.0" tooltip="Exit System"/>
        </VBox>
    </left>

    <!-- CENTER: SplitPane -->
    <center>
        <SplitPane dividerPositions="0.3" styleClass="split-pane">
            
            <!-- 280px Navigation Rail: Feeds -->
            <VBox minWidth="280.0" maxWidth="320.0" styleClass="nav-rail-sub">
                <padding>
                    <Insets top="24.0" bottom="24.0" left="16.0" right="16.0"/>
                </padding>
                <Label text="INCOMING FEED" styleClass="label-headline"/>
                <Label fx:id="lblStatus" text="Status: Listening..." styleClass="label-sub" style="-fx-text-fill: #6EE591;"/>
                
                <Region prefHeight="24.0"/>
                
                <HBox alignment="CENTER" spacing="8.0">
                    <ToggleButton fx:id="tglPrivate" text="PRIVATE" styleClass="toggle-button" prefWidth="120.0" selected="true"/>
                    <ToggleButton fx:id="tglGroup" text="GROUP" styleClass="toggle-button" prefWidth="120.0"/>
                </HBox>
                
                <Region prefHeight="24.0"/>
                
                <ListView fx:id="lstMessages" VBox.vgrow="ALWAYS" styleClass="list-view" />
                
                <Label text="* Double-click a transmission to attempt decryption" styleClass="label-sub" style="-fx-font-size: 10px; -fx-padding: 10 0 0 0;" />
            </VBox>
            
            <!-- Fluid Message Canvas with Blur Overlay for Decryption Challenge -->
            <StackPane styleClass="surface-card" style="-fx-background-radius: 0;">
                
                <!-- Background Base Graphics (Blurred) -->
                <VBox alignment="CENTER" spacing="16.0">
                    <effect>
                        <GaussianBlur radius="15.0" />
                    </effect>
                    <Label text="[ ENCRYPTED DATASTREAM ]" styleClass="label-mono" style="-fx-text-fill: #3E4A3F;"/>
                </VBox>
                
                <!-- Overlay: Decryption Challenge UI Concept -->
                <VBox alignment="CENTER" spacing="16.0" styleClass="blur-overlay">
                    <Label text="AWAITING DECRYPTION KEY" styleClass="label-headline" />
                    <Label text="Select a message from the left to begin decryption sequence." styleClass="label-sub" />
                </VBox>
                
            </StackPane>
        </SplitPane>
    </center>

</BorderPane>
