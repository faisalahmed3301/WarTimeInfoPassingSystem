<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox styleClass="standard-root" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.SenderController">
   <children>
      <Label text="TRANSMISSION INTERFACE">
         <font>
             <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <!-- Message Content Area -->
      <VBox fx:id="messageContentBox" maxWidth="600.0" spacing="8.0" alignment="CENTER_LEFT">
          <!-- Priority + Mode Toggle Row -->
          <HBox spacing="10.0" alignment="CENTER_LEFT">
              <Label text="Message Content:" style="-fx-font-weight: bold;"/>
              <HBox spacing="5.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 20;">
                  <ToggleButton fx:id="tglNormal" text="● NORMAL" prefHeight="28.0" style="-fx-font-size: 11px; -fx-background-color: #2A3020; -fx-text-fill: #00ff00; -fx-border-color: #00aa00; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12;" />
                  <ToggleButton fx:id="tglWarning" text="● WARNING" prefHeight="28.0" style="-fx-font-size: 11px; -fx-background-color: #2A3020; -fx-text-fill: #ffcc00; -fx-border-color: #aa8800; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12;" />
                  <ToggleButton fx:id="tglCritical" text="● CRITICAL" prefHeight="28.0" style="-fx-font-size: 11px; -fx-background-color: #2A3020; -fx-text-fill: #ff4444; -fx-border-color: #aa0000; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12;" />
              </HBox>
              <ToggleButton fx:id="tglMissionBrief" text="📋 Mission Brief" prefHeight="28.0" style="-fx-font-size: 11px; -fx-background-color: #414833; -fx-text-fill: #E8E8E8; -fx-border-color: #582F0E; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 4 12;" />
          </HBox>
          <!-- Normal TextArea (default visible) -->
          <TextArea fx:id="txtMessage" styleClass="terminal-input" prefHeight="150.0" wrapText="true" promptText="Enter confidential directive..." />
          <!-- Mission Brief Fields (hidden by default) -->
          <VBox fx:id="missionBriefBox" spacing="8.0" visible="false" managed="false" style="-fx-background-color: #1A1F14; -fx-border-color: #582F0E; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15;">
              <Label text="══════ MISSION BRIEF ══════" style="-fx-text-fill: #A4AC86; -fx-font-weight: bold; -fx-font-size: 13px;" />
              <HBox spacing="10.0" alignment="CENTER_LEFT">
                  <Label text="Mission:" prefWidth="80.0" style="-fx-text-fill: #E8E8E8; -fx-font-weight: bold;" />
                  <TextField fx:id="txtMission" promptText="e.g. Reconnaissance" prefWidth="400.0" />
              </HBox>
              <HBox spacing="10.0" alignment="CENTER_LEFT">
                  <Label text="Location:" prefWidth="80.0" style="-fx-text-fill: #E8E8E8; -fx-font-weight: bold;" />
                  <TextField fx:id="txtLocation" promptText="e.g. Sector B" prefWidth="400.0" />
              </HBox>
              <HBox spacing="10.0" alignment="CENTER_LEFT">
                  <Label text="Time:" prefWidth="80.0" style="-fx-text-fill: #E8E8E8; -fx-font-weight: bold;" />
                  <TextField fx:id="txtTime" promptText="e.g. 2200 hrs" prefWidth="400.0" />
              </HBox>
              <HBox spacing="10.0" alignment="CENTER_LEFT">
                  <Label text="Commander:" prefWidth="80.0" style="-fx-text-fill: #E8E8E8; -fx-font-weight: bold;" />
                  <ComboBox fx:id="cmbMissionCommander" prefWidth="400.0" promptText="Select Commander" />
              </HBox>
          </VBox>
      </VBox>
      
       <HBox alignment="CENTER" spacing="30.0">
           <VBox spacing="5.0">
               <Label text="Encryption Method:" />
               <ComboBox fx:id="cmbEncryption" prefWidth="180.0" />
           </VBox>
           
           <VBox spacing="5.0">
               <Label text="Authorizing Appointment:" />
               <ComboBox fx:id="cmbAppointment" prefWidth="180.0" />
           </VBox>

           <VBox spacing="5.0">
               <Label text="Target Group:" />
               <ComboBox fx:id="cmbGroup" prefWidth="180.0" />
           </VBox>

           <VBox spacing="5.0">
               <Label text="Individual Recipient:" />
               <ComboBox fx:id="cmbRecipient" prefWidth="180.0" />
           </VBox>
       </HBox>
      
      <VBox maxWidth="250.0" spacing="5.0" alignment="CENTER">
          <Label text="Encryption Key:" />
          <TextField fx:id="txtKey" alignment="CENTER" />
      </VBox>

      <Button fx:id="btnEmergency" mnemonicParsing="false" prefHeight="50.0" prefWidth="350.0" text="⚠ SEND EMERGENCY ALERT ⚠" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #8B0000; -fx-text-fill: #FFFFFF; -fx-border-color: #FF0000; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;" visible="false" managed="false" />
      
      <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0 0 0;">
          <Button fx:id="btnSend" mnemonicParsing="false" prefWidth="150.0" text="TRANSMIT" style="-fx-font-size: 14px;" />
          <Button fx:id="btnReturn" mnemonicParsing="false" prefWidth="150.0" text="RETURN" />
      </HBox>
   </children>
</VBox>
