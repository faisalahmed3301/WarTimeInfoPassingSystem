<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="rootPane" prefHeight="703.0" prefWidth="1279.0" styleClass="intro-root" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wartime.system.controller.IntroController">
   <children>
      <!-- Centered Content -->
      <VBox alignment="CENTER" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" maxWidth="1100.0" prefHeight="250.0">
               <children>
                  <Label fx:id="lblTitle" alignment="CENTER" contentDisplay="CENTER" lineSpacing="1.0" stylesheets="@styles.css" text="" textAlignment="CENTER" textFill="WHITE" wrapText="true">
                     <font>
                        <Font name="System Bold" size="64.0" />
                     </font>
                     <effect>
                        <DropShadow blurType="GAUSSIAN" color="BLACK" height="10.0" radius="10.0" spread="0.5" width="10.0" />
                     </effect>
                  </Label>
                  <Label fx:id="lblCursor" text="|" textFill="#FFD700" visible="true">
                     <font>
                        <Font name="System Bold" size="64.0" />
                     </font>
                     <effect>
                        <DropShadow blurType="GAUSSIAN" color="#FFD700" height="8.0" radius="8.0" spread="0.3" width="8.0" />
                     </effect>
                  </Label>
               </children>
            </HBox>
            <Button fx:id="btnNext" mnemonicParsing="false" prefHeight="55.0" prefWidth="380.0" style="-fx-font-size: 24px; -fx-padding: 10 30 10 30; -fx-cursor: hand; -fx-font-weight: bold;" text="Start Operations" textAlignment="CENTER" opacity="0.0" />
         </children>
      </VBox>

      <!-- Info Button Top Right -->
      <Button fx:id="btnInfo" mnemonicParsing="false" style="-fx-cursor: hand; -fx-font-size: 18px; -fx-min-width: 40; -fx-min-height: 40; -fx-background-radius: 20;" text="i" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0" />
   </children>
</AnchorPane>
